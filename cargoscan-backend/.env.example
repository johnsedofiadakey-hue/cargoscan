# Server Configuration
PORT=5000
API_PUBLIC_URL=http://localhost:5000
JWT_SECRET=your_jwt_secret_here
SUPER_ADMIN_KEY=your_super_admin_key_here
SUPER_ADMIN_EMAIL=admin@cargoscan.app
# Generate with: node -e "require('bcrypt').hash('change-me',10).then(console.log)"
SUPER_ADMIN_PASSWORD_HASH=

# Database Configuration
# Used for Prisma migrations and queries
DATABASE_URL=postgresql://postgres:password@localhost:5432/cargoscan?sslmode=disable
# Used for direct database access if needed
DIRECT_URL=postgresql://postgres:password@localhost:5432/cargoscan?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Paystack Configuration
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# WhatsApp Configuration (Meta Cloud API)
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
# Backward-compatible aliases accepted by the app:
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio Configuration (Fallback)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_number_here

# Storage Configuration
# Options: local, supabase, s3
STORAGE_PROVIDER=local

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key-here

# AWS S3 Configuration (if using S3)
S3_BUCKET=your-bucket-name
S3_REGION=your-region
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# AI Scan Quality Configuration
# Optional. If unset, scan quality falls back to local LiDAR/computer-vision gates.
OPENAI_API_KEY=
OPENAI_SCAN_QUALITY_MODEL=gpt-5-mini

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_key_here
EMAIL_FROM=noreply@cargoscan.app

# Frontend Configuration
VITE_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
