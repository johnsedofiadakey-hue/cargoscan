# ─────────────────────────────────────────
# CargoScan Frontend — Environment Variables
# Copy this to .env.local for local dev
# Production values are set in Firebase Hosting / build CI
# ─────────────────────────────────────────

# Backend API base URL (no trailing slash)
# Local:      http://localhost:5000/api
# Production: https://cargoscan-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# iOS TestFlight install URL (optional — shown as QR code in Mobile App tab)
VITE_IOS_TESTFLIGHT_URL=

# Firebase — Google OAuth (values from Firebase console → Project Settings → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cargoscan-app-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cargoscan-app-2026
VITE_FIREBASE_STORAGE_BUCKET=cargoscan-app-2026.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sentry (optional — frontend error tracking)
# Get from: https://sentry.io → Settings → Projects → your-project → Client Keys
VITE_SENTRY_DSN=
